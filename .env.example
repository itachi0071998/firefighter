# ---------------------------------------------------------------------------
# Firefighter configuration. Copy to .env and fill in ONLY what you need.
# Every integration defaults to a mock adapter, so the system runs with an
# entirely empty .env file. Set a provider to "real" to switch it over.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
PORT=8787
FF_DB_PATH=./data/firefighter.db
FF_DEMO_REPO=./demo-repo

# --- GitHub -----------------------------------------------------------------
# GITHUB_PROVIDER: mock | gh-cli | api
#   mock    - local git repo + in-process GitHub API emulation (default)
#   gh-cli  - uses your authenticated `gh` CLI  (run: gh auth login)
#   api     - uses GITHUB_TOKEN against api.github.com
# Minimum fine-grained PAT permissions for `api`:
#   Contents: Read & Write | Pull requests: Read & Write | Metadata: Read
GITHUB_PROVIDER=mock
GITHUB_TOKEN=
GITHUB_REPO=            # e.g. my-org/checkout-service
GITHUB_BASE_BRANCH=main

# --- Slack ------------------------------------------------------------------
# SLACK_PROVIDER: mock | webhook | bot | bridge
#   mock    - renders Block Kit payload into the dashboard/DB (default)
#   webhook - SLACK_WEBHOOK_URL, no scopes required, locked to one channel
#   bot     - SLACK_BOT_TOKEN (xoxb-...), minimum scope: chat:write
#   bridge  - writes payload to an outbox for an external connector to deliver
SLACK_PROVIDER=mock
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#incidents

# --- Ticketing (Linear or Jira) ---------------------------------------------
# TICKET_PROVIDER: mock | linear | jira | bridge
TICKET_PROVIDER=mock
# Linear: personal API key (lin_api_...). Note: Linear personal keys are not
# scope-limited; they inherit full workspace access.
LINEAR_API_KEY=
LINEAR_TEAM_KEY=ENG
# Jira: API token. OAuth equivalent scopes: read:jira-work, write:jira-work
JIRA_BASE_URL=          # e.g. https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INC

# --- Incident source --------------------------------------------------------
# INCIDENT_SOURCE: fixture | sentry
#   fixture - built-in demo incidents (default; evals always force this)
#   sentry  - live issues from a real Sentry project
# Token needs READ scopes only: project:read, event:read, org:read.
# SENTRY_TOKEN is accepted as an alias for SENTRY_AUTH_TOKEN (sentry-cli's name).
INCIDENT_SOURCE=fixture
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://sentry.io
# Pin one issue for a reproducible demo. If that issue is retired, Firefighter
# falls back to the newest unresolved issue rather than failing.
SENTRY_ISSUE_ID=

# --- LLM --------------------------------------------------------------------
# LLM_PROVIDER: deterministic | openai | anthropic
#   deterministic - scored heuristic analyzer, no network, fully reproducible
#                   (default; evals always force this regardless of setting)
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Safety / reliability ---------------------------------------------------
# FF_MODE: mitigate | full
#   mitigate - stop after the revert PR (default). The culprit is PROVEN by
#              bisection and the revert is mechanical, so it is the only action
#              taken automatically.
#   full     - also synthesise a fix plus a regression test and open them as a
#              DRAFT pull request. A generated patch encodes a guess about
#              intent, so it is never presented as an equal of the revert.
#              (evals always force this so both tracks stay covered)
FF_MODE=mitigate
FF_MAX_ATTEMPTS=3
FF_RETRY_BASE_MS=150
# Fault injection for evals, e.g. "notify_slack:transient:2"
FF_FAIL_INJECT=

# --- Test / demo hooks (leave unset in normal use) --------------------------
# FF_CRASH_AFTER=create_incident_ticket  kill the process right after a named
#                                        mutating tool succeeds, to prove that
#                                        restarting creates no duplicate
# FF_CORRUPT_FIX=1                       emit a knowingly broken fix patch, to
#                                        exercise the "tests fail" path
# FF_LLM_FORCE_FAIL=1                    simulate an LLM provider outage
# FF_FREEZE_AT=2026-09-13T09:20:00.000Z  freeze the clock for reproducible runs
# FF_LOG_LEVEL=debug                     debug | info | warn | error
# FF_QUIET=1                             suppress non-error logs
